# Terminate production TLS outside Compose and forward the public URLs below.
# Local defaults expose the web app on 4173, Convex HTTP actions on 3210,
# and the Convex API/WebSocket endpoint on 3211.
PUBLIC_WEB_URL=http://localhost:4173
PUBLIC_CONVEX_URL=http://localhost:3211
INTERNAL_CONVEX_URL=http://convex:3210
BETTER_AUTH_ALLOWED_ORIGIN=http://localhost:4173

# Generate independent random values of at least 24 characters.
BETTER_AUTH_SECRET=
SECRET_MASTER_KEY=
WORKER_TOKEN=

# One operator-registered GitHub App shared by the whole deployment.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=

# Container-absolute storage paths. Keep the defaults unless Compose mounts change.
CONVEX_DATA_PATH=/convex/data
CODEX_HOME_ROOT=/data/codex-home
WORKSPACE_ROOT=/workspaces

# Optional host port overrides.
WEB_PORT=4173
CONVEX_SITE_PORT=3210
CONVEX_API_PORT=3211
WORKER_HEALTH_PORT=8081
CONVEX_RUST_LOG=warn

# Release smoke configuration. Use only a designated disposable repository.
SMOKE_SUBSCRIPTION_TIMEOUT_SECONDS=600
SMOKE_OWNER_EMAIL=
SMOKE_OWNER_PASSWORD=
SMOKE_GITHUB_STORAGE_STATE=
SMOKE_GITHUB_REPOSITORY=
SMOKE_GITHUB_REPOSITORY_ID=
SMOKE_DISPOSABLE_MARKER=
SMOKE_GITHUB_BASE_BRANCH=main
SMOKE_OPENAI_API_KEY=
