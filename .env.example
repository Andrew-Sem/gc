# Доступ к GitHub. PAT с правами на repo, checks и чтение защиты ветки.
GITHUB_TOKEN=

# Секрет подписи вебхуков. Тот же самый задаётся на репозитории в настройках вебхука.
GITHUB_WEBHOOK_SECRET=

# Ключ для Codex.
OPENAI_API_KEY=

# Необязательный endpoint Codex. Пусто означает официальный endpoint OpenAI.
OPENAI_BASE_URL=

# Внешний origin, по которому GitHub шлёт вебхуки.
PUBLIC_URL=http://localhost:8080

# Адрес и порт HTTP. Админка не имеет входа, наружу публикуется только путь вебхука.
LISTEN_ADDR=127.0.0.1:8080

# Пути, которые обязаны переживать рестарт.
DB_PATH=./gc.db
CODEX_HOME=./codex-home
WORKSPACE_ROOT=./workspaces

# Параметры реального smoke. Только выделенный disposable репозиторий.
SMOKE_REPOSITORY=
SMOKE_REPOSITORY_ID=
SMOKE_BASE_BRANCH=main
