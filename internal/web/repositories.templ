package web

templ repositoriesView(repositories []string) {
	<!DOCTYPE html>
	<title>Репозитории</title>
	<h1>Репозитории</h1>
	<form hx-post="/repositories">
		<label>Репозиторий <input name="repo" placeholder="owner/name" required/></label>
		<button>Подключить</button>
	</form>
	@repositoryList(repositories)
}

templ repositoryList(repositories []string) {
	<ul id="repositories">
		for _, name := range repositories {
			<li data-repository={ name }>{ name }</li>
		}
	</ul>
}
