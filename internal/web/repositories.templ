package web

import (
	"fmt"

	"github.com/Andrew-Sem/gc/internal/domain"

	"github.com/Andrew-Sem/gc/ui"
)

templ repositoriesView(repositories []repositoryRow) {
	<!DOCTYPE html>
	@ui.Head()
	<title>Repositories</title>
	<h1>Repositories</h1>
	<a href="/runs">Runs</a>
	<a href="/pulls">Pull requests</a>
	<a href="/settings">Instance settings</a>
	@repositoriesPanel(repositories, panelState{})
}

templ repositoriesPanel(repositories []repositoryRow, state panelState) {
	<section id="repositories-panel" hx-target="#repositories-panel" hx-swap="outerHTML">
		<form hx-post="/repositories">
			<label>Repository <input name="repo" placeholder="owner/name" required/></label>
			<button>Connect</button>
		</form>
		switch state.problem {
			case noAccess:
				<p role="alert">The app is not installed on this repository</p>
			case malformedName:
				<p role="alert">Enter the repository as owner/name</p>
			case githubSilent:
				<p role="alert">Could not check access: GitHub did not respond</p>
			case tokenRejected:
				<p role="alert">GitHub rejected the app. Check GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_FILE.</p>
			case githubFailed:
				<p role="alert">Could not check access: GitHub failed. Try again later.</p>
			case rateLimited:
				<p role="alert">GitHub rate limit reached. Try again later.</p>
			case moved:
				<p role="alert">GitHub moved this repository. Enter its current name.</p>
			case notConnected:
				<p role="alert">This repository is not connected</p>
			case noRoom:
				<p role="status">{ fmt.Sprintf("No room: %d of %d PRs are open. Merge or close some, or raise the limit in the ", state.open, state.limit) }<a href={ templ.SafeURL(settingsPath(state.repository)) }>settings</a>.</p>
			case sweepRequested:
				<p role="status">Sweep requested. Merged PRs show on GitHub.</p>
			case alreadyRunning:
				<p role="status">{ fmt.Sprintf("Already running: run %d. Follow it on the ", state.running) }<a href="/runs">runs page</a>.</p>
			case alreadyRequested:
				<p role="status">A run is already requested. Follow it on the <a href="/runs">runs page</a>.</p>
			case runRequested:
				<p role="status">Run requested. Follow it on the <a href="/runs">runs page</a>.</p>
		}
		@repositoryList(repositories)
	</section>
}

templ repositoryList(repositories []repositoryRow) {
	<ul id="repositories">
		for _, row := range repositories {
			<li data-repository={ row.Name }>
				{ row.Name }
				{ settingsSummary(row.Settings) }
				<button hx-post={ runPath(row.Name) }>Run now</button>
				<button hx-post={ sweepPath(row.Name) }>Sweep now</button>
				<button hx-post={ disconnectPath(row.Name) }>Disconnect</button>
				<a href={ templ.SafeURL(settingsPath(row.Name)) }>Settings</a>
			</li>
		}
	</ul>
}

func settingsSummary(settings domain.Settings) string {
	summary := fmt.Sprintf("every %d h, at most %d open", settings.Pace, settings.Limit)
	if settings.Pace == 0 {
		summary = fmt.Sprintf("only on Run now, at most %d open", settings.Limit)
	}
	if settings.Merge {
		summary += ", merges green PRs"
	}
	return summary
}
